PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://hospital_app:YOURPASSWORD@localhost:5432/hospital_management_db

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
HOSPITAL_NAME=Hospital Management System

CONSULTATION_FEE=500

# Transactional Email Delivery (SMTP Configuration)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_SECURE=false
MAIL_FROM="Hospital Management System" <no-reply@hospital.local>
